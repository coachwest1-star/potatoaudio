#!/usr/bin/env bash
set -euo pipefail
DEVICE="${1:-default}"
if [[ "$DEVICE" != "default" && ! "$DEVICE" =~ ^hw:[0-9]+,[0-9]+$ ]]; then echo "Invalid ALSA device" >&2; exit 2; fi
systemctl stop mpd || true
trap 'systemctl start mpd >/dev/null 2>&1 || true' EXIT
timeout 5 speaker-test -D "$DEVICE" -c 2 -t sine -f 880 -l 1 >/dev/null 2>&1
